# Servidor
NODE_ENV=development
PORT=3000

# Orígenes permitidos, separados por coma y sin rutas.
# Agrega aquí la URL real del frontend si cambia el puerto o el dominio.
CORS_ORIGINS=http://localhost:5173

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=inventario_app
DB_PASSWORD=CAMBIAR_POR_UNA_CLAVE_SEGURA
DB_NAME=gestion_equipos
DB_CONNECTION_LIMIT=10

# Autenticación y sesiones
AUTH_SESSION_HOURS=8
AUTH_MAX_ATTEMPTS=5
AUTH_LOCK_MINUTES=15

# Active Directory - Validar Cuenta
AD_API_URL=https://sap30003.distriluz.com.pe:60000/ActiveDirectory/Api/ActiveDirectory/ValidarDato
AD_SISTEMA=1
AD_KEY=PEGAR_AQUI_LA_KEY_PROPORCIONADA_POR_DISTRILUZ
AD_TIMEOUT_MS=10000

# URL pública del frontend usada dentro de las etiquetas QR
FRONTEND_URL=http://localhost:5173
